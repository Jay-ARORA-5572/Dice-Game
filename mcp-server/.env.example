# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real values here.

# Path to your Firebase service account key JSON file (see README
# "Optional: MCP Server" for how to generate one). This grants full admin
# access to your Realtime Database, bypassing security rules -- keep it
# private and never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Your Realtime Database URL (same one used in js/firebase-config.js),
# e.g. https://dicee-game-18-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
